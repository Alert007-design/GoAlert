# Skabelon til lokal udvikling.
# Kopiér til .env.local og udfyld værdierne — .env.local er git-ignoreret.
# I produktion sættes de samme variabler i Vercel → Settings → Environment Variables.
#
#   cp .env.local.example .env.local
#
# Tomme værdier betyder "ikke konfigureret". Se kommentarerne for hvad der
# holder op med at virke, hvis en variabel mangler.


# --- Airtable -------------------------------------------------------------
# Påkrævet af /api/signup, /api/portal, /api/webhooks/stripe og cron-scannet.
# Uden disse kan intet gemmes eller slås op, og alle fire ruter fejler.
# Token: Airtable → Developer hub → Personal access tokens.
# Base-id: står i Airtable-basens URL (starter med "app").
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Tabellen der modtager tilmeldinger fra forsiden. Default: Signups
AIRTABLE_TABLE_NAME=


# --- Stripe ---------------------------------------------------------------
# Påkrævet af /api/checkout, /api/portal og /api/webhooks/stripe.
# Brug test-nøgler (sk_test_…) lokalt, aldrig live-nøglen.
STRIPE_SECRET_KEY=

# Signeringshemmelighed til webhook-endpointet. Lokalt får du den fra
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# Price-id (price_…) pr. antal søgeord kunden vælger. Checkout afviser
# med 500, hvis price-id'et for det valgte antal mangler.
STRIPE_PRICE_2KW=
STRIPE_PRICE_3KW=
STRIPE_PRICE_4KW=
STRIPE_PRICE_5KW=


# --- Resend (udgående e-mail) ---------------------------------------------
# Begge skal være sat, ellers sender cron-scannet ingen mails.
RESEND_API_KEY=
# Afsender, fx "Gossip Alert <alerts@gossipalert.dk>". Domænet skal være
# verificeret i Resend.
RESEND_FROM=


# --- Reddit (kilde i cron-scannet) ----------------------------------------
# Valgfri. Mangler de, springes Reddit over — nyheder og Folketinget
# scannes stadig.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Default: server:gossip-alert:v1.0 (by /u/yourusername)
# Reddit beder om en identificerbar user agent — sæt din egen.
REDDIT_USER_AGENT=


# --- Cron og scan-indstillinger -------------------------------------------
# Beskytter /api/cron/scan. Er den sat, kræver ruten
# `Authorization: Bearer <værdi>`. Er den tom, kan enhver trigge et scan.
CRON_SECRET=

# Hvor gamle fund må være for at tælle med. Default: 24
SCAN_MAX_AGE_HOURS=

# Hvor mange dage tilbage dedup-tjekket kigger. Default: 14
DEDUP_WINDOW_DAYS=


# --- Site ------------------------------------------------------------------
# Bruges til Stripes success/cancel- og portal-retur-URL'er.
# Default: https://gossipalert.dk (checkout) / https://www.gossipalert.dk (portal).
# Lokalt: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
