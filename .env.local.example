# Skabelon til lokal udvikling.
# Kopiér til .env.local og udfyld værdierne — .env.local er git-ignoreret.
# I produktion sættes de samme variabler i Vercel → Settings → Environment Variables.
#
#   cp .env.local.example .env.local
#
# Tomme værdier betyder "ikke konfigureret". Se kommentarerne for hvad der
# holder op med at virke, hvis en variabel mangler.


# --- Afbrydere ------------------------------------------------------------
# Begge er slået FRA, når de er tomme. Kun præcis "true" tænder dem.
# De skal tændes aktivt — glemmer man at sætte dem, er resultatet den
# lukkede tilstand, ikke den åbne.

# Betaling: Stripe checkout, kundeportal og webhook, priser på forsiden,
# "opgrader"-beskeder og links til /administrer i mails.
# Er den fra, kontaktes Stripe slet ikke, og de tre betalingsruter svarer
# 503 med en forklaring. Ingen Stripe-kode er slettet.
PAYMENTS_ENABLED=

# Tilmelding: formularen på forsiden og /api/signup.
# Er den fra, kan fremmede ikke oprette sig selv som aktive kunder.
# Egne søgeord tilføjes i stedet direkte i Airtable-tabellen Customers.
# Er den til uden betaling, kan man tilmelde sig med op til 5 søgeord gratis.
SIGNUPS_ENABLED=


# --- Airtable -------------------------------------------------------------
# Påkrævet af /api/signup, /api/portal, /api/webhooks/stripe og cron-scannet.
# Uden disse kan intet gemmes eller slås op, og alle fire ruter fejler.
# Token: Airtable → Developer hub → Personal access tokens.
# Base-id: står i Airtable-basens URL (starter med "app").
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Tabellen der modtager tilmeldinger fra forsiden. Default: Signups
AIRTABLE_TABLE_NAME=


# --- Stripe ---------------------------------------------------------------
# Kun nødvendigt, hvis PAYMENTS_ENABLED er sat til "true".
# Er betaling slået fra, bruges ingen af disse, og Stripe kontaktes ikke.
# Brug test-nøgler (sk_test_…) lokalt, aldrig live-nøglen.
STRIPE_SECRET_KEY=

# Signeringshemmelighed til webhook-endpointet. Lokalt får du den fra
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# Price-id (price_…) pr. antal søgeord kunden vælger. Checkout afviser
# med 500, hvis price-id'et for det valgte antal mangler.
STRIPE_PRICE_2KW=
STRIPE_PRICE_3KW=
STRIPE_PRICE_4KW=
STRIPE_PRICE_5KW=


# --- Resend (udgående e-mail) ---------------------------------------------
# Begge skal være sat, ellers sender cron-scannet ingen mails.
RESEND_API_KEY=
# Afsender, fx "Gossip Alert <alerts@gossipalert.dk>". Domænet skal være
# verificeret i Resend.
RESEND_FROM=


# --- Reddit (kilde i cron-scannet) ----------------------------------------
# Reddit er SLÅET FRA. Nøglerne har aldrig været sat, så kilden fejlede hver
# dag og skrev "Reddit kunne ikke tjekkes" i hver eneste mail.
# Sæt REDDIT_ENABLED=true OG begge nøgler for at tænde den igen.
REDDIT_ENABLED=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Default: server:gossip-alert:v1.0 (by /u/yourusername)
# Reddit beder om en identificerbar user agent — sæt din egen.
REDDIT_USER_AGENT=


# --- Cron og scan-indstillinger -------------------------------------------
# PÅKRÆVET. Beskytter /api/cron/scan og alle /api/debug/*-ruter.
# Er den ikke sat, svarer ruterne 503 og laver ingenting — med vilje, så en
# åben rute ikke kan stå ubemærket.
# Vercel sender den automatisk med som `Authorization: Bearer <værdi>`, når
# variablen findes i projektet.
CRON_SECRET=

# Hvor gamle fund må være for at tælle med. Default: 24
# Bemærk: vinduet kan strækkes op til 48 timer, hvis forrige cron-kørsel lå
# længere tilbage end det — se README under "Vinduet".
SCAN_MAX_AGE_HOURS=


# --- Site ------------------------------------------------------------------
# Bruges til Stripes success/cancel- og portal-retur-URL'er.
# Default: https://gossipalert.dk (checkout) / https://www.gossipalert.dk (portal).
# Lokalt: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
